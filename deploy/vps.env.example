# Hostname only: no https://, path, port or trailing slash.
PAKAR_DOMAIN=pakar.example.com

POSTGRES_DB=pakar
POSTGRES_USER=pakar
# Generate a fresh password: openssl rand -hex 32
# Hex avoids URL-encoding issues in DATABASE_URL.
POSTGRES_PASSWORD=REPLACE_WITH_64_HEX_CHARACTERS

LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Restrict routing to this provider; no provider/model fallback.
PAKAR_OPENROUTER_PROVIDER_ORDER='["primeintellect/fp8"]'
# Policy ceilings in USD per million tokens; request is USD per request.
PAKAR_OPENROUTER_MAX_PRICE='{"prompt":0.04,"completion":0.35,"request":0}'
PAKAR_MAX_RUN_COST_USD=0.10
PAKAR_CREDIT_RESERVE_USD=0.10

# Optional. Copy the reviewed indicator catalog as well as the key.
BPS_API_KEY=
PAKAR_BPS_INDICATORS=[]

# Keep these names stable across upgrades; separate from local demo volumes.
BACKEND_VOLUME_NAME=pakar_vps_backend_data
POSTGRES_VOLUME_NAME=pakar_vps_postgres_data
PAKAR_ALLOWED_LLM_HOSTS=openrouter.ai

# Optional: Pull pre-built images from GitHub Container Registry (GHCR) to avoid building on 2 GB VPS
# If left commented or unset, pakar.sh will build locally from source.
# PAKAR_BACKEND_IMAGE=ghcr.io/jerome-88/pakar-backend:latest
# PAKAR_FRONTEND_IMAGE=ghcr.io/jerome-88/pakar-frontend:latest
