BACKEND_PORT=5001
FRONTEND_PORT=5173
POSTGRES_DB=pakar
POSTGRES_USER=pakar
POSTGRES_PASSWORD=pakar
POSTGRES_PORT=5432
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=pakar_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
JOB_DELAY=0.08
MAX_UPLOAD_BYTES=33554432
POLICY_PROVIDER=deterministic
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Opt in only with a provider supporting strict JSON Schema responses.
LLM_STRUCTURED_OUTPUTS=true
ZEP_API_KEY=
OASIS_ENABLED=true
DEFAULT_SIMULATION_ENGINE=oasis
OASIS_RUNTIME_DIR=./backend/oasis_engine_runtime
OASIS_DATA_DIR=./backend/data/oasis/simulations
LLM_FALLBACK_POLICY=raise
LLM_MAX_OUTPUT_TOKENS=2500
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
PROVIDER_TIMEOUT_SECONDS=120
LLM_REQUEST_TIMEOUT_SECONDS=90
OASIS_PREPARE_TIMEOUT_SECONDS=900
OASIS_REPORT_TIMEOUT_SECONDS=900
REPORT_AGENT_MAX_TOOL_CALLS=2
REPORT_AGENT_MAX_REFLECTION_ROUNDS=1
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=180
STORAGE_BACKEND=local
STORAGE_PATH=/app/data/uploads
FIREBASE_STORAGE_BUCKET=
FIREBASE_STORAGE_PREFIX=pakar
GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/firebase-service-account.json
FIREBASE_CREDENTIALS_HOST_PATH=/dev/null
TRUSTED_HOSTS=localhost,127.0.0.1
PRODUCTION=false
AUTH_REQUIRED=false
AUTH_MAX_FAILURES=10
AUTH_WINDOW_SECONDS=300
VITE_API_URL=/backend
VITE_DEMO_MODE=false

# PAKAR official-source integration (server-side only)
BPS_API_KEY=
PAKAR_BPS_INDICATORS=[]

# Optional routing ceiling: JSON; prompt/completion USD per million tokens.
PAKAR_OPENROUTER_MAX_PRICE='{"prompt":0.04,"completion":0.35,"request":0}'

# Pin existing physical volume names when upgrading an existing deployment.
BACKEND_VOLUME_NAME=pakar_backend_data
POSTGRES_VOLUME_NAME=pakar_postgres_data

# Paid business inference: shared run cap and credit reserve, USD.
PAKAR_MAX_RUN_COST_USD=0.10
PAKAR_CREDIT_RESERVE_USD=0.10
PAKAR_ALLOWED_LLM_HOSTS=openrouter.ai
PAKAR_OPENROUTER_PROVIDER_ORDER='["primeintellect/fp8"]'
