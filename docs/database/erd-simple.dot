digraph ERD {
graph [rankdir=TB, bgcolor="#F8FAFC", pad="0.45", nodesep="0.5", ranksep="0.8", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontcolor="#152E41", labelloc=t,
label=<<FONT POINT-SIZE="26"><B>PAKAR - ERD Sederhana</B></FONT><BR/><FONT POINT-SIZE="15">9 tabel utama | kolom dan relasi inti</FONT><BR/><BR/><FONT POINT-SIZE="12">PK = ID utama | FK = penghubung tabel | lingkaran + kaki tiga = nol atau banyak</FONT><BR/><BR/>>];
node [shape=plain, fontname="Arial"];
edge [color="#607C90", penwidth=1.5, dir=both, arrowtail=teetee, arrowhead=crowodot, arrowsize=0.8];
"users" [label=<<TABLE BORDER="1" COLOR="#CFDAE3" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD COLSPAN="2" BGCOLOR="#365D8D" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="18"><B>Pengguna</B></FONT><BR ALIGN="LEFT"/><FONT COLOR="white" POINT-SIZE="10">users</FONT></TD></TR><TR><TD BGCOLOR="#EDF3FA" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#365D8D" POINT-SIZE="11">PK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">id</FONT></TD></TR><TR><TD BGCOLOR="#EDF3FA" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#365D8D" POINT-SIZE="11">&#32;</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">name</FONT></TD></TR><TR><TD BGCOLOR="#EDF3FA" ALIGN="LEFT" CELLPADDING="7"><FONT COLOR="#365D8D" POINT-SIZE="11">&#32;</FONT></TD><TD ALIGN="LEFT" CELLPADDING="7"><FONT POINT-SIZE="13">email</FONT></TD></TR></TABLE>>];
