digraph ERD {
graph [rankdir=LR, bgcolor="#F8FAFC", pad="0.6", nodesep="0.45", ranksep="1.1", splines=polyline, outputorder=edgesfirst, fontname="Arial", fontsize=24, fontcolor="#152E41", labelloc=t, labeljust=l,
label="PAKAR - Detail modul bisnis dan infrastruktur\nPostgreSQL | dari definisi SQLAlchemy | 09 November 2026\nPK = primary key   FK = foreign key   ? = nullable   UQ = unik satu kolom\nGaris: FK fisik; lingkaran = opsional; kaki tiga = banyak"];
node [shape=plain, fontname="Arial"];
edge [color="#607C90", penwidth=1.1, arrowsize=0.9, dir=both, fontname="Arial", fontsize=9];
