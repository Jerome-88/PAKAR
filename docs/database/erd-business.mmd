erDiagram
    direction LR
    business_analyses {
        varchar id PK "required"
        varchar project_id FK "required"
        varchar baseline_id FK "nullable"
        varchar status "required"
        varchar stage "required"
        jsonb input_snapshot "required"
        jsonb result "required"
        timestamp_with_time_zone created_at "required"
        timestamp_with_time_zone updated_at "required"
        varchar(128) idempotency_key "nullable"
    }
    business_chat_turns {
        varchar id PK "required"
        varchar project_id FK "required"
        integer sequence "required"
        varchar status "required"
        jsonb request "required"
        jsonb input_snapshot "required"
        jsonb response "nullable"
        timestamp_with_time_zone created_at "required"
        timestamp_with_time_zone updated_at "required"
        varchar(128) idempotency_key "required"
    }
    business_claims {
        varchar id PK "required"
        varchar project_id FK "required"
        varchar document_id FK "required"
        jsonb content "required"
    }
    business_documents {
        varchar id PK "required"
        varchar project_id FK "required"
        varchar name "required"
        text storage_key "required"
        integer size_bytes "required"
        varchar(64) sha256 "required"
        varchar status "required"
        jsonb content "required"
        timestamp_with_time_zone created_at "required"
    }
    business_events {
        varchar analysis_id PK,FK "required"
        integer sequence PK "required"
        varchar type "required"
        jsonb payload "required"
        timestamp_with_time_zone created_at "required"
    }
    business_idea_revisions {
        varchar id PK "required"
        varchar idea_id FK "required"
        varchar project_id FK "required"
        integer version "required"
        jsonb content "required"
        timestamp_with_time_zone created_at "required"
        varchar(128) idempotency_key "required"
    }
    business_ideas {
        varchar id PK "required"
        varchar project_id FK "required"
        varchar(160) title "required"
        integer version "required"
        timestamp_with_time_zone created_at "required"
        timestamp_with_time_zone updated_at "required"
        varchar(128) idempotency_key "required"
    }
    business_personas {
        varchar id PK "required"
        varchar project_id FK "required"
        jsonb content "required"
    }
    business_projects {
        varchar id PK "required"
        varchar owner_user_id FK "required"
        jsonb context "required"
        integer revision "required"
        timestamp_with_time_zone created_at "required"
        timestamp_with_time_zone updated_at "required"
        varchar(128) idempotency_key "nullable"
    }
    job_attempts {
        varchar id PK "required"
        varchar job_id FK "required"
        integer attempt "required"
        varchar worker_id "required"
        varchar execution_token "required"
        timestamp_with_time_zone started_at "required"
        timestamp_with_time_zone heartbeat_at "required"
        timestamp_with_time_zone completed_at "nullable"
        varchar outcome "nullable"
        varchar error_code "nullable"
        text error_message "nullable"
    }
    jobs {
        varchar id PK "required"
        varchar simulation_id FK "nullable"
        varchar analysis_id FK "nullable"
        varchar business_chat_turn_id FK "nullable"
        varchar run_id FK "nullable"
        varchar stage "required"
        varchar status "required"
        jsonb config "required"
        timestamp_with_time_zone created_at "required"
        timestamp_with_time_zone updated_at "required"
        timestamp_with_time_zone available_at "required"
        timestamp_with_time_zone started_at "nullable"
        timestamp_with_time_zone completed_at "nullable"
        varchar lease_owner "nullable"
        timestamp_with_time_zone lease_expires_at "nullable"
        timestamp_with_time_zone heartbeat_at "nullable"
        integer attempts "required"
        integer max_attempts "required"
        text last_error "nullable"
        jsonb result "nullable"
        integer input_revision "required"
        varchar execution_token "nullable"
        integer lease_generation "required"
        timestamp_with_time_zone cancel_requested_at "nullable"
        timestamp_with_time_zone pause_requested_at "nullable"
        varchar error_code "nullable"
        varchar error_class "nullable"
        varchar retryable "nullable"
        timestamp_with_time_zone next_retry_at "nullable"
        integer progress "required"
        jsonb checkpoint "nullable"
        timestamp_with_time_zone dead_lettered_at "nullable"
        varchar idempotency_key "nullable"
    }
    provider_spend_accounts {
        varchar(64) id PK "required"
        numeric(24__12) available_usd "required"
    }
    provider_spend_reservations {
        varchar(160) id PK "required"
        varchar(64) account_id FK "required"
        numeric(24__12) ceiling_usd "required"
        numeric(24__12) charged_usd "nullable"
    }
    sessions {
        varchar token_hash PK "required"
        varchar user_id FK "required"
        timestamp_with_time_zone created_at "required"
        timestamp_with_time_zone expires_at "required"
    }
    users {
        varchar id PK "required"
        varchar name "required"
        varchar email UK "required"
        text password_hash "required"
        timestamp_with_time_zone created_at "required"
    }
    business_projects ||..o{ business_analyses : "project_id"
    business_analyses |o..o{ business_analyses : "baseline_id"
    business_projects ||..o{ business_chat_turns : "project_id"
    business_projects ||..o{ business_claims : "project_id"
    business_documents ||..o{ business_claims : "document_id"
    business_projects ||..o{ business_documents : "project_id"
    business_analyses ||--o{ business_events : "analysis_id"
    business_ideas ||..o{ business_idea_revisions : "idea_id"
    business_projects ||..o{ business_idea_revisions : "project_id"
    business_projects ||..o{ business_ideas : "project_id"
    business_projects ||..o{ business_personas : "project_id"
    users ||..o{ business_projects : "owner_user_id"
    jobs ||..o{ job_attempts : "job_id"
    business_analyses |o..o{ jobs : "analysis_id"
    business_chat_turns |o..o{ jobs : "business_chat_turn_id"
    provider_spend_accounts ||..o{ provider_spend_reservations : "account_id"
    users ||..o{ sessions : "user_id"
