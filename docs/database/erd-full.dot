"users" [label=<<TABLE BORDER="1" COLOR="#CFDAE3" CELLBORDER="0" CELLSPACING="0" BGCOLOR="white"><TR><TD COLSPAN="3" BGCOLOR="#365D8D" ALIGN="LEFT" CELLPADDING="10"><FONT COLOR="white" POINT-SIZE="14"><B>users</B></FONT></TD></TR><TR><TD PORT="id_in" ALIGN="LEFT" BGCOLOR="#EDF3FA" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#365D8D">PK</FONT></TD><TD ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">id</FONT></TD><TD PORT="id_out" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#63788A">VARCHAR</FONT></TD></TR><TR><TD PORT="name_in" ALIGN="LEFT" BGCOLOR="#EDF3FA" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#365D8D">&#32;</FONT></TD><TD ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">name</FONT></TD><TD PORT="name_out" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#63788A">VARCHAR</FONT></TD></TR><TR><TD PORT="email_in" ALIGN="LEFT" BGCOLOR="#EDF3FA" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#365D8D">UQ</FONT></TD><TD ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">email</FONT></TD><TD PORT="email_out" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#63788A">VARCHAR</FONT></TD></TR><TR><TD PORT="password_hash_in" ALIGN="LEFT" BGCOLOR="#EDF3FA" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#365D8D">&#32;</FONT></TD><TD ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">password_hash</FONT></TD><TD PORT="password_hash_out" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#63788A">TEXT</FONT></TD></TR><TR><TD PORT="created_at_in" ALIGN="LEFT" BGCOLOR="#EDF3FA" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#365D8D">&#32;</FONT></TD><TD ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="11">created_at</FONT></TD><TD PORT="created_at_out" ALIGN="LEFT" CELLPADDING="5"><FONT POINT-SIZE="10" COLOR="#63788A">TIMESTAMP WITH TIME ZONE</FONT></TD></TR></TABLE>>];
