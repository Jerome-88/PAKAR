# Ensure shell scripts, Dockerfiles, and web server configs maintain LF line endings
# across Windows and Linux to prevent "$'\r': command not found" errors on Ubuntu.
*.sh text eol=lf
*.bash text eol=lf
Dockerfile text eol=lf
Caddyfile text eol=lf
*.conf text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.py text eol=lf
*.md text eol=lf
*.env* text eol=lf

# Binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.svg text
*.dump binary
*.tar.gz binary
*.pdf binary
*.docx binary

