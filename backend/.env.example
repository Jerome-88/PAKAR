HOST=0.0.0.0
PORT=5001
DATA_DIR=./data
DATABASE_URL=postgresql+psycopg://pakar:pakar@localhost:5432/pakar
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
SESSION_COOKIE_NAME=pakar_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
JOB_DELAY=0.08
MAX_UPLOAD_BYTES=33554432
MAX_FILE_UPLOAD_BYTES=20971520
MAX_TOTAL_UPLOAD_BYTES=1073741824
MAX_FILES_PER_PROJECT=20
MAX_ACTIVE_PROJECTS_PER_USER=100
PROJECT_RETENTION_DAYS=30
MAX_PDF_PAGES=200
MAX_EXTRACTED_CHARS=2000000
MAX_CHUNKS_PER_DOCUMENT=5000
POLICY_PROVIDER=deterministic
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.6-35b-a3b
# Enable only for a model/provider supporting strict JSON Schema responses.
LLM_STRUCTURED_OUTPUTS=true
ZEP_API_KEY=
OASIS_ENABLED=true
DEFAULT_SIMULATION_ENGINE=oasis
OASIS_RUNTIME_DIR=./oasis_engine_runtime
OASIS_DATA_DIR=./data/oasis/simulations
LLM_FALLBACK_POLICY=raise
LLM_MAX_OUTPUT_TOKENS=2500
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
PROVIDER_TIMEOUT_SECONDS=120
LLM_REQUEST_TIMEOUT_SECONDS=90
OASIS_PREPARE_TIMEOUT_SECONDS=900
OASIS_REPORT_TIMEOUT_SECONDS=900
REPORT_AGENT_MAX_TOOL_CALLS=2
REPORT_AGENT_MAX_REFLECTION_ROUNDS=1
EMBEDDED_WORKER=true
WORKER_POLL_SECONDS=0.5
WORKER_LEASE_SECONDS=180
STORAGE_BACKEND=local
STORAGE_PATH=./data/uploads
FIREBASE_STORAGE_BUCKET=
FIREBASE_STORAGE_PREFIX=pakar
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
PRODUCTION=false
AUTH_REQUIRED=false
AUTH_MAX_FAILURES=10
AUTH_WINDOW_SECONDS=300

# PAKAR official-source integration (server-side only)
BPS_API_KEY=
PAKAR_BPS_INDICATORS=[]

# Optional OpenRouter routing caps: USD per million prompt/completion tokens;
# request is USD per request. A cap rejects more expensive routes, not a model swap.
PAKAR_OPENROUTER_MAX_PRICE='{"prompt":0.04,"completion":0.35,"request":0}'
# Optional JSON list of explicit providers; keeps fallbacks disabled and caps intact.
PAKAR_OPENROUTER_PROVIDER_ORDER='["primeintellect/fp8"]'

# Paid business inference: shared run cap and credit reserve, USD.
PAKAR_MAX_RUN_COST_USD=0.10
PAKAR_CREDIT_RESERVE_USD=0.10
PAKAR_ALLOWED_LLM_HOSTS=openrouter.ai
